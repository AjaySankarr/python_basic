# Database (Render provides this automatically when attaching a Postgres database)
# Example for local: postgresql+asyncpg://postgres:postgres@localhost:5432/college_db
# In Docker Compose: postgresql+asyncpg://postgres:postgres@db:5432/college_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/college_db

# Security / JWT
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis / Rate Limiter
# Local: redis://localhost:6379/0
# Docker Compose: redis://redis:6379/0
# Render Redis / Upstash: redis://... or rediss://...
# In-memory fallback (if Redis not used): memory://
REDIS_URL=redis://localhost:6379/0

# Email (SMTP) Configuration (Optional for initial boot)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
